# YouTube Data API key (required)
# Get one free at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Podcast Index (optional — for podcast search)
# Register free at: https://podcastindex.org/
# PODCAST_INDEX_KEY=your_key_here
# PODCAST_INDEX_SECRET=your_secret_here
